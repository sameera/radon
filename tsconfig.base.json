{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "types": ["node"],
        "paths": {
            "@radon/shared": ["./libs/shared/src/index.ts"],
            "@radon/design-system": ["./libs/design-system/tokens.ts"]
        }
    }
}
