{
    "manifest_version": 3,
    "name": "Raiden",
    "version": "0.0.0",
    "description": "Sprint goals and a hierarchical timeline for GitHub Projects.",
    "icons": {
        "128": "raiden-128x.png"
    },
    "content_scripts": [
        {
            "matches": ["https://github.com/*"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ]
}
