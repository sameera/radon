{
    "name": "design-system",
    "projectType": "library",
    "tags": ["scope:shared"],
    "targets": {
        "typecheck": {
            "executor": "nx:run-commands",
            "options": { "command": "tsc --noEmit -p libs/design-system/tsconfig.json", "cwd": "{workspaceRoot}" }
