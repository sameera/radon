# Copy this file to .env.backend.local and add your GitHub App credentials.
GITHUB_CLIENT_ID='<app-client-id>'
GITHUB_CLIENT_SECRET='<app-client-secret>'

# Return URLs include the trailing slash; origins do not.
RAIDEN_ALLOWED_REDIRECTS='http://localhost:4210/'
RAIDEN_ALLOWED_ORIGINS='http://localhost:4210'
RAIDEN_LOG_LEVEL='info'

# For the extension, append its callback URL and origin to the comma-separated lists above.
