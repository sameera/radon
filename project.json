{
    "name": "raiden",
    "projectType": "application",
    "targets": {
        "dev": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "commands": [
                    "node apps/web/build.ts --local",
                    "python3 -m http.server 4210 --bind 127.0.0.1 --directory dist/apps/web-local"
                ],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            }
        }
    }
}
